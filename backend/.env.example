# Backend environment. Copy to backend/.env for local dev.

# --- Database (Postgres+pgvector via docker compose) -----------------------
DATABASE_URL=postgresql+psycopg://ce725:ce725@localhost:5432/ce725

# --- API auth (single-user, Phase 1-3) ------------------------------------
API_KEY=dev-single-user-key
APP_ENV=development
LOG_LEVEL=INFO

# --- LLM provider (OpenRouter) --------------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Mapping agent model (W8). google/gemini-2.0-flash-001 is cheap + fast and
# strong at structured tool-use, which is what the mapping agent needs.
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Mapping strategy — "auto" | "llm" | "deterministic"
#   auto           : LLM when OPENROUTER_API_KEY is set, deterministic otherwise
#   llm            : always Gemini via OpenRouter (needs the key; ~1s per BOQ line)
#   deterministic  : hybrid-search only, pre-batched embeddings (~5-10s per run)
MAPPING_STRATEGY=auto

# Embeddings — OpenAI text-embedding-3-small via OpenRouter, truncated to
# 1024 dims to match the pgvector(1024) column.
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBED_DIM=1024

# Optional: tell OpenRouter which app this is (shows up in your dashboard).
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=CE 725 BOQ
